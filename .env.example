# ── Customer Retention Workflow — Environment Variables ──────────────
# Copy this file to .env and adjust values for your environment.

# Path to the customer CSV dataset (default: bundled sample)
# CUSTOMER_CSV=src/customer_retention/resources/sample_customers.csv

# Path to the retention policy markdown
# POLICY_PATH=src/customer_retention/resources/politica_retencion.md

# Path to a trained churn model (.py or .pkl); omit to use the heuristic
# CHURN_MODEL_PATH=

# Ollama endpoint for LLM-backed recommendations (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# Streamlit UI settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
